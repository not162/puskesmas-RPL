# ===== .env PRODUKSI — salin ke /var/www/puskesmas/.env lalu isi =====
APP_NAME="Puskesmas Sehat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://puskesmas.example.go.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puskesmas
DB_USERNAME=puskesmas_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# Proxy tepercaya: 127.0.0.1 untuk Nginx di server yang sama; "*" bila di belakang Cloudflare/penyeimbang beban
TRUSTED_PROXIES=127.0.0.1

# Kata sandi awal tiap peran (dipakai seeder SEKALI saat instalasi pertama). Wajib berbeda & kuat, lalu ganti setelah masuk.
SEED_PASSWORD_SUPER_ADMIN=
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_DOKTER_UMUM=
SEED_PASSWORD_DOKTER_KANDUNGAN=
SEED_PASSWORD_APOTEKER=
SEED_PASSWORD_LOKET=
SEED_PASSWORD_PASIEN=

# HMAC (isi dengan: php -r "echo bin2hex(random_bytes(32));")
HMAC_SECRET=
KIOSK_ID=kiosk-loket-1
KIOSK_HMAC_SECRET=

# Email OTP (Gmail: aktifkan Verifikasi 2 Langkah, buat Sandi Aplikasi)
OTP_PENGIRIMAN=antrean
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# WebSocket (Reverb di belakang Nginx: klien lewat 443, server di 127.0.0.1:6001)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=puskesmas.example.go.id
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001

# WhatsApp (Fonnte)
WA_DRIVER=fonnte
FONNTE_TOKEN=
WA_PENGIRIMAN=antrean

# Cloudflare Turnstile (anti-robot)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lokasi mysqldump bila tidak di PATH (biasanya tidak perlu di Linux)
MYSQLDUMP_PATH=
# Hosting tanpa Supervisor (cPanel): jalankan antrean lewat penjadwal
ANTREAN_LEWAT_CRON=false

